# ── kapso-voice-manager environment variables ──────────────────────────────

# Kapso Function URL (from: kapso functions list)
KAPSO_AGENT_CONFIG_URL=https://agent-config.your-project.workers.dev

# Default agent ID if Kapso doesn't pass one
DEFAULT_AGENT_ID=

# ── WhatsApp (set as Pipecat Cloud secrets in production) ──────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# ── Gemini Live (default — required) ──────────────────────────────────────
GOOGLE_API_KEY=

# ── Sarvam AI — full stack for Indian languages (optional) ────────────────
SARVAM_API_KEY=

# ── Local dev fallbacks (used when Kapso KV is not reachable) ─────────────
AGENT_NAME=Assistant
LLM_PROVIDER=gemini
TTS_PROVIDER=gemini
TTS_VOICE=Puck
LANGUAGE=en
GREETING=
SYSTEM_PROMPT=You are a helpful voice assistant. Speak both English and Malayalam as needed. Keep responses short and conversational.
