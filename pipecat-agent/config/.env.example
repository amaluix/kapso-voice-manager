# ── kapso-voice-manager environment variables ──────────────────────────────

# Kapso Function URL (from: kapso functions list)
KAPSO_AGENT_CONFIG_URL=https://agent-config.your-project.workers.dev

# Default agent ID if not passed in the call body
DEFAULT_AGENT_ID=

# ── WhatsApp — stored as Pipecat Cloud secrets in production ───────────────
# Ref: https://docs.pipecat.ai/deployment/pipecat-cloud/guides/whatsapp.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Local dev only (not needed in Pipecat Cloud):
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# ── Gemini Live (default pipeline — required) ──────────────────────────────
# Model: gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_API_KEY=

# ── Sarvam AI — full stack for Indian languages (future) ──────────────────
SARVAM_API_KEY=

# ── Local dev fallbacks (used when Kapso KV is not reachable) ─────────────
ENV=local
AGENT_NAME=Assistant
LLM_PROVIDER=gemini
TTS_VOICE=Puck
LANGUAGE=en
GREETING=
SYSTEM_PROMPT=You are a helpful voice assistant. Speak both English and Malayalam as needed. Keep responses short and conversational.
